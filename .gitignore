node_modules/
dist/
build/
*.ipk
.DS_Store

# local, per-person settings
tv.env
src/config/catalog.local.ts

# Local screenshots and reference material
.impeccable/review/
.impeccable/references/

# Local environment, device credentials and session captures
.local/
.env
.env.*
